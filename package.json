{
  "name": "remote-ssh-mcp",
  "version": "1.0.0",
  "description": "Persistent shared SSH hosts for Codex CLI and Claude Code.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuiFG/remote-ssh-mcp.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "remote-ssh-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/design.md",
    "docs/adr",
    "skills",
    "GLOSSARY.md",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "npm run build && tsx --test test/mcp.integration.ts",
    "test:package": "npm run build && tsx test/package-smoke.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:clients": "npm run build && tsx test/client-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "minimatch": "10.2.6",
    "proper-lockfile": "4.1.2",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/ssh2": "1.15.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
